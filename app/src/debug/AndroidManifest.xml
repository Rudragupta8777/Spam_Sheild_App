<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug-only additions. Lets the SMS screening pipeline be triggered over adb so it can be
    tested without a second phone. See README / the DEBUG_TEST_ACTION constant in SmsReceiver
    for the exact adb broadcast command.

    This filter is absent from release builds.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:networkSecurityConfig="@xml/network_security_config"
        tools:replace="android:networkSecurityConfig">
        <receiver
            android:name=".SmsReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.spamshield.app.DEBUG_TEST_SMS" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".model.ModelUpdateReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.spamshield.app.CHECK_MODEL_UPDATE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
